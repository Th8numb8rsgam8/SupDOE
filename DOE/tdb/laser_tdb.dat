$>

DOE-PARAMETERS:

{"Laser Max Range": {"type": "cont", "values": [20000, 30000]},
"Minimum Speed": {"type": "cont", "values": [40, 60]}
}

END DOE-PARAMETERS

<$

EXECUTE
INSTRUCTIONS-FOR:
  
  UAN-DEFINITION
    SIDES
      red                blue
    COMMAND-CHAINS
      red_chain          blue_chain
    EXPLICIT-NETS
      broadcast
    IMPLICIT-NETS
      landline

    PLAYERS
      bomber             target
      sam_rgt            sam_btry
    TACTICS
      bomber_tactics
      sam_rgt_tactics
      sam_btry_tactics
    ZONES
      target_area        sam_zone

    MANEUVERS
      air_intercept
      air_targets
      alpha
      bomb_target
      ground_targets
      post_launch

    ELEMENTS
      bomber_ele
      sam_btry_ele
      sam_rgt_ele
      target_ele

    SUSCEPTIBILITIES
      bomber_sig
      target_sig
    MOVERS
      bomber_body
    SENSOR-RECEIVERS
      bomber_radar_rx
      sam_radar_rx
    SENSOR-TRANSMITTERS
      baomber_radar_tx
      sam_radar_tx
    THINKERS
      bomber_think
      sam_think
    WEAPONS
      bomber_weapon
      sam_launcher
    COMM-RECEIVERS
      comm_rcvr
    COMM-TRANSMITTERS
      comm_xmit
    DISRUPTORS
      jukebox

    CAPABILITIES
      bomber_body_data
      bomber_radar_rx_data
      sam_radar_rx_data
      bomber_radar_tx_data
      sam_radar_tx_data
      bomber_think_data
      sam_think_data
      bomber_weapon_data
      sam_launcher_data
      comm_rcvr_data
      comm_xmit_data

    ORDNANCE
      bomb
      tnt

    FUEL
      rocket_fuel
    CM-EXPENDABLES
      flare
    FUTURE-PLAYERS
  END-UAN

  TDB
       TDB for Bomber Demonstration Scenario

  INSERT-MODE

  PLAYER-STRUCTURE target
     LOCATION 1
        ELEMENT 11 target_ele  DISCRETE  1
	   SUSCEPTIBILITY @{Target Signature}@
  END PLAYER-STRUCTURE

  SUSCEPTIBILITY target-sig
    IR-RAD-TABLE
      DIMENSION 1 AZ (DEG) 0.  180.
        DIMENSION 2 EL (DEG) -90.  90.
	   IR-RAD WATTS/STERADIAN 475.
    END IR-RAD-TABLE

    OPT-CS DIMENSION 1 AZ (DEG)  0.  180.
      DIMENSION 2 EL (DEG) -90.  90. OCS (M2) 10.0
    END OPT-CS

    INHERENT-CONTRAST  1.0 (NO-UNITS)

    TGT-REFLECTIVITY
      DIMENSION 1 IR-BAND     DEFAULT
        REFLECTANCE (NO-UNITS)         0.0
    END TGT-REFLECTIVITY

    RCS-TABLE
      DIMENSION 1 AZ (DEG)  0.  180.
        DIMENSION 2 EL (DEG) -90.  90.
	  RCS (M2) 1.0
    END RCS-TABLE

    SNR-ELE-INTERACTIONS
       bomber_radar_rx
    END SNR-ELE-INTERACTIONS
  END SUSCEPTIBILITY

  PLAYER-STRUCTURE bomber
    TACTIC bomber_tactics
    LOCATION 1
      ELEMENT 11 bomber_ele DISCRETE 1  SUSCEPTIBILITY bomber_sig
        THINKER   110 bomber_think        CAPABILITY bomber_think_data
	SNR-RCVR  120 bomber_radar_rx     CAPABILITY bomber_radar_rx_data
	SNR_XMTR  121 bomber_radar_tx     CAPABILITY bomber_radar_tx_data
	WEAPON
	   ORDNANCE bomb DISCRETE  14 (ROUNDS)
	 MOVER    140 bomber_body
    LINKAGES
      110 WITH 120    120 WITH 121
  END PLAYER-STRUCTURE

  TACTIC  bomber_tactics
    EVALUATION-RATES
      ENG-EVAL-RATE 0.08 (1/SEC)
    END EVALUATION-RATES
    MOVE-TO-ENG NO
    SALVO-FIRING
      DIMENSION 1 TGT-MOTION APPROACHING RECEDING
        ROUNDS-FIRED (ROUNDS) 4
	ROUNDS-FIRED (ROUNDS) 0
    END SALVO-FIRING
    MOVE-OPTIONS NONE END MOVE-OPTIONS
    ATK-PRIORITIES
      DIMENSION 1 LIST-NAME ground-targets
        TGT-ELEMENTS          sam_rgt_ele   target_ele
    END ATK-PRIORITIES
    MOVE-PLANS
      PLAN bomb_target
         FOCUS-ON PRIORITY ground_target
      END-PLAN
    END MOVE-PLANS
    RESOURCE-ALLOCATION
      LETHAL-ENGAGE-QUEUE-ADD
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE bomber_weapon
	      IFF-STATUS IS-NOT FRIEND AND 3D-TGT-LOC WITHIN target_area
	      AND WPN-STATUS IS-NOT WPN-NON/OP
	      AND BELIEVED-ALIVE
	      AND FIRED-BEFORE IS NO
	  USE FILTER 1 SELECTIONS FOR FILTER 2
	    WPN-TYPE bomber_weapon
	      BEEN-ASSIGNED IS YES OR ENG-CONTROL-MODE IS bomber
	  FROM FILTER 2 SELECTIONS
	    CHOOSE-FROM bomber-weapon  PICK-AT-MOST 1 NOW 1 TOTAL
      END LETHATL-ENGAGE-QUEUE-ADD
      LETHAL-ENGAGE-QUEUE-DROP
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE   bomber_weapon
	      IFF-STATUS IS FRIEND OR
	      3D-TGT-LOC OUTSIDE target_area AND
	        ENG-CONTROL-MODE IS bomber
              OR BEEN-ASSIGNED IS NO AND ENG-CONTROL-MODE IS-NOT bomber
	      OR WPN-STATUS IS WPN-NON/OP
	      OR BELIEVED-DEAD
	      OR AVAILABLE-RESOURCE NO-MORE-THAN 0 (ROUNDS)
	           RE: bomb ORDNANCE
	      OR FIRED-BEFORE IS YES
	  FROM FILTER 1 SELECTIONS
	    CHOOSE-FROM bomber_weapon  PICK-AT-MOST 1 NOW
      END LETHAL-ENGAGE-QUEUE-DROP
      LETHAL-ENGAGE-START
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE bomber_weapon
	      TOTAL-ENG'S NO-MORE-THAN 3 (TGTS)
	  USE FILTER 1 SELECTIONS FOR FILTER 2
	    WPN-TYPE bomber-weapon
	      2D-REL-TGT-OFFSET < 2. (KM)
	      AND 2D-DIST < 4. (KM)
	      AND FIRED-BEFORE IS-NOT YES
	  FROM FILTER 2 SELECTIONS
	    CHOOSE-FROM bomber_weapon
	      PICK-AT-MOST 1 NOW 1 TOTAL
      END LETHAL-ENGAGE-START
      LETHAL-ENGAGE-STOP
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE bomber_weapon
	      2D-REL-TGT-OFFSET > 2.5 (KM)
	      OR 2D-DIST > 4.5 (KM)
	      OR AVAILABLE-RESOURCE NO-MORE-THAN 0 (ROUNDS)
	           RE: bomb  ORDNANCE
	      OR REL-SUB-HDG > 80.0 (DEG)
	  FROM FILTER 1 SELECTIONS
	    CHOOSE-FROM bomber_weapon  PICK-AT-MOST 1 NOW
      END LETHAL-ENGAGE-STOP
      LETHAL-ENGAGE-FIRING-START
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE bomber_weapon
	      2D-REL-TGT-OFFSET < 2. (KM)
	      AND 2D-DIST < 4.0 (KM)
	      AND REL-SUB-JHDG < 70.0 (DEG)
	      AND FIRING-NOW IS NO
	  FROM FILTER 1 SELECTIONS
	    CHOOSE-FROM  bomber_weapon
	        WITH-ORDNANCE bomb
		WITH-ELEMENT ANYONE
	      PICK-AT-MOST 1 NOW
      END LETHAL-ENGAGE-FIRING-START
      LETHAL-ENGAGE-FIRING-STOP
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE bomber_weapon
	      2D-REL-TGT-OFFSET > 2.5 (KM)
	      OR 2D-DIST > 4.5 (KM)
	      OR REL-SUB-HDG > 80.0 (DEG)
	      OR BELIEVED-DEAD
	  FROM FILTER 1 SELECTIONS
	    CHOOSE-FROM bomber_weapon  PICK-AT-MOST 1 NOW
      END LETHAL-ENGAGE-FIRING-STOP
    END RESOURCE-ALLOCATION
  END TACTIC

  SUSCEPTIBILITY bomber_sig
    IR-RAD-TABLE DIMENSION 1 AZ (DEG) 0. 180.
      DIMENSION 2 EL (DEG) -90.  90. IR-RAD (WATTS/STERADIAN) 30000.
    END IR-RAD-TABLE
    OPT-CS DIMENSION 1 AZ (DEG) 0.  180.
      DIMENSION 2 EL (DEG) -90. 90. OCS (M2) 10.0
    END OPT-CS
    INHERENT-CONTRTTAST  1.0 (NO-UNITS)
    TGT-REFLECTIVITY
      DIMENSION 1 IR-BAND       DEFAULT
        REFLECTANCE (NO-UNITS)
	   0.0
    END TGT-REFLECTIVITY
    RCS-TABLE DIMENSION 1 AZ (DEG) 0. 180.
      DIMENSION 2 EL (DEG) -90. 90. RCS (M2) 4.0
    END RCS-TABLE
    SNR-ELE-INTERACTIONS
      sam_radar_rx
    END SNR-ELE-INTERACTIONS
  END SUSCEPTIBILITY

  CAPABILITY bomber_radar_rx_data
    HITS-TO-ESTABLISH-TRACK 4 (NO-UNITS)
    ONE-M2-DETECT-RNG  40.E3 (M)
    PEAK-GAIN          20.0  (DB)
    EFFECTIVE-EARTH-RADIUS 8495.E3 (M)
    VERTICAL-OFFSET 0.0 (M)
    RCVR-BANDWIDTH 1.6 (MHZ)
    SENSING-MODE-RATES
      ACQ-SENSING-RATE     0.167 (1/SEC)
    END SENSING-MODE-RATES
    DETECTION-SENSITIVITIES
      SENSING-THRESHOLD        13.0 (DB)
      RECEIVER-NOISE         -150.0 (DB)
      INTERNAL-LOSSES         -10.0 (DB)
    END DETECTION-SENSITIVITIES
    ANTENNA-PATTERN
      DIMENSION 1 AZ (DEG) 0.  180.
        DIMENSION 2 EL (DEG) -90.  90.
	  GAIN (DB)    20.
    END ANTENNA-PATTERN
    SNR-CHARACTERISTICS
      FREQ-DRIVEN  ACQ  RADAR  IFF
    END SNR-CHARACTERISTICS
    QUALITY-OF-DATA
      TYPE-OF-ELEMENT  AZ   ALT       TYPE-OF-PLAYER
      PLANAR-LOCATION  SPD  HEADING   NO-OF-ELEMENTS
    END QUALITY-OF-DATA
    RNG-ALT-CAPABILITY
      DIMENSION 1 RNG (M) MAX-ALT (KM)
        MIN-ALT (KM) MAX-ALT (KM)
	  -20.0      20.0
    END RNG-ALT-CAPABILITY
  END CAPABILITY

  CAPABILITY bomber_radar_tx_data
    EFFECTIVE-EARTH-RADIUS 8495.E3 (M)
    INTERNAL-LOSS         -10.0 (DB)
    PEAK-POWER-OUTPUT      5.E6 (WATTS)
    PULSE-REPETITION-FREQ 250.0 (HZ)
    XMIT-FREQ               3.0 (GHZ)
    PEAK-GAIN              30.0 (DB)
    ANTENNA-PATTERN DIMENSION 1 AZ (DEG) 0. 180.
      DIMENSION 2 EL (DEG) -90. 90. GAIN (DB) 30.
    END ANTENNA-PATTERN
  END CAPABILITY

  CAPABILITY bomber_weapon_data
    NUM-SIMULTANEOUS-ROUND 3  (NO-UNITS)
    PLATFORM-VEL-ATTEN     1. (NO-UNITS)
    WPN-TIME-DELAYS
      SHOOT-TIME-DELAY  2.5 (SEC)   SALVO-FIRING-DELAY  1.5 (SEC)
    END WPN-TIME-DELAYS
    WPN-CHARACTERISTICS
      3D-FLYOUT  LAUNCH-ENVELOPE-P(K)
      IMPLICIT-FLYOUT  UNCONTROLLED  NO-SELF-DESTRUCT
    END WPN-SPD-CAPABILITY
    WPN-PK
      DIMENSION 1 ELEMENT-TYPES DEFAULT
        DIMENSION 2 ABS-OFFSET (KM) 0.  2.
	  DIMENSION 3 RNG (KM) -10.  0.   3.  10.
	      PK (NO-UNITS)        0.  0.6  0.4
    END WPN-PK
  END CAPABILITY

  CAPABILITY bomber_body_data
    MAX-ACCELERATION 20. (M/SEC/SEC)
    MIN-TURN-RADIUS 1000. (M)
    MOVER-ALTITUDE-LIMITS
      MIN-ALT  0.0 (M)     MAX-ALT  15.0 (KM)
    END MOVER-ALTITUDE-LIMITS
    MOVER-CLIMB/DIVE-LIMITS
      MAX-DIVE-RATE  30.0 (M/SEC)    MAX-CLIMB-RATE  50.0 (M/SEC)
    END MOVER-CLIMB/DIVE-LIMITS
    MOVER-SPEED-LIMITS
      MIN-SPD   @{Minimum Speed}@ (M/SEC)     MAX-SPD 50.0 (M/SEC)
    END MOVER-SPEED-LIMITS
  END CAPABILITY

  CAPABILITY bomber_think_data
    TIME-BEFORE-DROP 1. (MIN)
    TIME-TO-THINK
      REVIEW-INFORMATION   80. (MILLISEC)
      CONSIDER-MOVE       145. (MILLISEC)
      EVAL-ENGAGE-THREAT   50. (MILLISEC)
      EVAL-LETHAL-ENGAGE   50. (MILLISEC)
      EVAL-FIRING          50. (MILLISEC)
      ASSIMILATE-INTELL    50. (MILLISEC)
      CONSIDER-ASG/CANCEL  50. (MILLISEC)
      EVAL-ASSIGN-THREAT   45. (MILLISEC)
      RECOG-MSG           180. (MILLISEC)
      RECOG-SNR-EVENT     130. (MILLISEC)
      RECOG-PHYS-EVENT     30. (MILLISEC)
    END TIME-TO-THINK
  END CAPABILITY

  PLAYER-STRUCTURE sam_rgt
    TACTIC sam_rgt_tactics
    LOCATION 1
      ELEMENT 11 sam_rgt_ele DISCRETE 1
        THINKER    111 sam_think         CAPABILITY sam_think_data
	COMM-RCVR  112 comm_rcvr         CAPABILITY comm_rcvr_data
	COMM-XMTR  113 comm_xmit         CAPABILITY comm_xmit_data
	COMM-RCVR  114 comm_rcvr         CAPABILITY comm_rcvr_data
	COMM-XMTR  115 comm_xmit         CAPABILITY comm_xmit_data
        SNR-RCVR   116 sam_radar_rx      CAPABILITY sam_radar_rx_data
	SNR-XMTR   117 sam_radar_tx      CAPABILITY sam_radar_tx_data
    LINKAGES
      111 WITH 116    112 WITH 113    114 WITH 115    116 WITH 117
  END PLAYER-STRUCTURE

  TACTIC sam_rgt_tactics
    ASG-CMD-CHAIN red_chain
    EVALUATION-RATES
      ASG-EVAL-RATE    0.067 (1/SEC)
    END EVALUATION-RATES
    RESOURCE-ALLOCATION
      LETHAL-ASSIGNMENT-QUEUE-ADD
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    SUB-TYPE sam_btry
	      IFF-STATUS IS-NOT FRIEND
	      AND 3D-TGT-LOC WITHIN sam_zone
	            RE: SUB-LOC REFERENCE-LOC
	      AND SUB-STATUS IS SUB-OP
	      AND BELIEVED-ALIVE
	  USE FILTER 1 SELECTIONS FOR FILTER 2
	    SUB-TYPE sam_btry
	      BEEN-ASSIGNED IS YES OR ENG-CONTROL-MODE IS sam_rgt
	  FROM FILTER 2 SELECTIONS
	    CHOOSE-FROM sam_btry PICK-AT-MOST 4 NOW
      END LETHAL-ASSIGNMENT-QUEUE-ADD
      LETHAL-ASSIGNMENT-QUEUE-DROP
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    SUB-TYPE sam_btry
	      IFF-STATUS IS FRIEND
	      OR 3D-TGT-LOC OUTSIDE sam_zone
	            RE: SUB-LOC REFERENCE-LOC
		 AND ENG-CONTROL-MODE IS sam_rgt
	      OR BEEN-ASSIGNED IS NO AND
	         ENG-CONTROL-MODE IS-NOT sam_rgt
	      OR BELIEVED-DEAD
	  FROM FILTER 1 SELECTIONS
	    CHOOSE-FROM sam_btry PICK-AT-MOST 4 NOW
      END LETHAL-ASSIGNMENT-QUEUE-DROP
      LETHAL-ASSIGNMENT-START
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    SUB-TYPE sam_btry
	      TOTAL-ASGS NO-MORE-THAN 1 (TGTS)
	      AND  2D-DIST < 45. (KM)
	  USE FILTER  1 SELECTIONS FOR FILTER 2
	    SUB-TYPE sam_btry
	      2D-DIST < 30. (KM)
	  FROM FILTER 2 SELECTIONS
	    CHOOSE-FROM sam_btry PICK-AT-MOST 1 NOW 1 TOTAL
	  FROM FILTER 1 SELECTIONS
	    CHOOSE-FROM sam_btry PICK-AT-MOST 1 NOW 1 TOTAL
      END LETHAL-ASSIGNMENT-START
      LETHAL-ASSIGNMENT-STOP
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    SUB-TYPE sam_btry
	      2D-DIST > 100. (KM)
	  FROM FILTER 1 SELECTIONS
	    CHOOSE-FROM sam_btry PICK-AT-MOST 2 NOW
      END LETHAL-ASSIGNMENT-STOP
    END RESOURCE-ALLOCATION
    
    MSG-RPT-GUIDE
      DIMENSION 1 CMD-CHAIN-TYPES red_chain
        REPORT-RESPONSIBILITY CMDR
    INTELL-REPORT-FREQ
      DIMENSION 1 CMD-CHAIN-TYPES red_chain
        RPT-RATE (1/SEC)  0.05
    END INTELL-REPORT-FREQ
    SNR-RPT-GUIDE
      DIMENSION 1 CMD-CHAIN-TYPES red_chain
        DIMENSION 2 SNR-TYPE sam_radar_rx
	  REPORT-RESPONSIBILITY CMDR
    END SNR-RPT-GUIDE
  END TACTIC

  CAPABILITY  sam_think_data
    TIME-BEFORE-DROP 60. (SEC)
    TIME-TO-THINK
      ASSIMILATE-INTELL    0.1 (SEC)
      CONSIDER-ASG/CANCEL  0.1 (SEC)
      EVAL-ASSIGN-THREAT   0.1 (SEC)
      EVAL-ENGAGE-THREAT   0.1 (SEC)
      EVAL-EMCON-CHANGE    0.1 (SEC)
      EVAL-FIRING          0.1 (SEC)
      EVAL-LETHAL-ENGAGE   0.1 (SEC)
      RECOG-MSG            0.1 (SEC)
      RECOG-PHYS-EVENT     0.1 (SEC)
      RECOG-SNR-EVENT      0.1 (SEC)
      REVIEW-INFORMATION   0.1 (SEC)
    END TIME-TO-THINK
  END CAPABILITY

  CAPABILITY  comm_rcvr_data
    VERTICAL-OFFSET    30.0 (M)
    RCVR-BANDWIDTH      4.  (MHZ)
    RCVR-NOISE       1.E-11 (WATTS)
    RECOGNITION-THRESH  8.0 (DB)
    ANTENNA-PATTERN
      DIMENSION 1 AZ (DEG) 0.      180.
        DIMENSION 2 EL (DEG) -90.  90.
	  GAIN (DB)  3.
    END ANTENNA-PATTERN
  END CAPABILITY

  CAPABILITY  sam_radar_rx_data
    SNR-CHARACTERISTICS
      FREQ-DRIVEN  BOTH-ACQ/TRK  RADAR  IFF
    END SNR-CHARACTERISTICS
    ANTGR-PATTERN
      PATTERN-ID               13.0 (NO-UNITS)
      GAIN-CORRECTION           0.0 (DB)
      MIN-GAIN                -10.0 (DB)
      EL-ROTATION               0.0 (DEG)
    END ANTGR-PATTERN
    PEAK-GAIN                  26.0 (DB)
    DETECTION-SENSITIVITIES
      SENSING-THRESHOLD        10.0 (DB)
      POST-LOCKON-THRESHOLD     3.0 (DB)
      RECEIVER-NOISE         -150.0 (DB)
      INTERNAL-LOSSES         -10.0 (DB)
    END DETECTION-SENSITIVITIES
    EFFECTIVE-EARTH-RADIUS  8495.E3 (M)
    HITS-TO-ESTABLISH-TRACK       2 (NO-UNITS)
    MAX-PARALLEL-TRACKS           1 (NO-UNITS)
    ONE-M2-DETECT-RNG         30.E3 (M)
    QUALITY-OF-DATA
      TYPE-OF-ELEMENT  AZ   ALT      TYPE-OF-PLAYER
      PLANAR-LOCATION  SPD  HEADING  NO-OF-ELEMENTS
    END QUALITY-OF-DATA
    RCVR-BANDWIDTH            1.6E6 (HZ)
    RNG-ALT-CAPABILITY
      DIMENSION 1 RNG (M) 0.0   40.E3
        MIN-ALT (M) MAX-ALT (M)
	  0.0      10.E3
    END RNG-ALT-CAPABILITY
    SENSING-MODE-RATES
      ACQ-SENSING-RATE     0.167 (1/SEC)
      TRACK-SENSING-RATE   0.333 (1/SEC)
      FIRING-SENSING-RATE  0.555 (1.SEC)
    END SENSING-MODE-RATES
    SNR-DOPPLER-LIMITS
    SNR-TIME-DELAYS
      START-LOCKON-DELAY     3.0 (SEC)
      MAX-COAST-TIME         8.0 (SEC)
      POST-LOCKON-S/N-DELAY  4.0 (SEC)
    END SNR-TIME-DELAYS
    SNR-TRACKING-PROBABILITIES
      INITIAL-LOCK-PROB    0.750 (NO-UNITS)
      CONTINUE-TRACK-PROB  0.985 (NO-UNITS)
    END SNR-TRACKING-PROBABILITIES
    VERTICAL-OFFSET 6.0 (M)
  END CAPABILITY

  CAPABILITY sam_radar_tx_data
    EFFECTIVE-EARTH-RADIUS 8495.E3 (M)
    ANTGR-PATTERN
      PATTERN-ID              13.0 (NO-UNITS)
      GAIN-CORRECTION          0.0 (DB)
      MIN-GAIN               -10.0 (DB)
      EL-ROTATION              0.0 (DEG)
    END ANTGR-PATTERN
    PEAK-GAIN                 26.0 (DB)
    INTERNAL-LOSS            -10.0 (DB)
    PEAK-POWER-OUTPUT          5.E6 (WATTS)
    PULSE-REPETITION-FREQ    250.0 (HZ)
    XMIT-FREQ                  3.0E9 (HZ)
  END CAPABILITY

  PLAYER-STRUCTURE sam_btry
    TACTIC sam_btry_tactics
    LOCATION 1
      ELEMENT 11 sam_btry_ele DISCRETE 1
        THINKER   110 sam_think      CAPABILITY sam_think_data
	COMM_RCVR 111 comm_rcvr      CAPABILITY comm_rcvr_data
	COMM-XMTR 112 comm_xmit      CAPABILITY comm_xmit_data
	SNR-RCVR  121 sam_radar_rx   CAPABILITY sam_radar_rx_data
	SNR-XMTR  122 sam_radar_tx   CAPABILITY sam_radar_tx_data
	WEAPON    150 sam_launcher   CAPABILITY sam_launcher_data
	  ORDNANCE tnt  DISCRETE 1 (ROUNDS)
    LINKAGES
      111 WITH 112    121 WITH 122    110 WITH 121    121 WITH 150
  END PLAYER-STRUCTURE

  TACTIC  sam_btry_tactics
    ASG-CMD-CHAIN red_chain
    EVALUATION-RATES
      ENG-EVAL-RATE    0.05 (1/SEC)
      EMCON-EVAL-RATE  0.10 (1/SEC)
    END EVALUATION-RATES
    INTELL-REPORT-FREQ
      DIMENSION 1 CMD-CHAIN-TYPES  red_chain
        RPT-RATE 1/SEC            0.0333
    END INTELL-REPORT-FREQ
    MAX-MSG-ATTEMPTS 4 (NO-UNITS)
    MAX-SNR-PERCEPTIONS 7 TGTS
    MOVE-TO-ENG NO
    MSG-RPT-GUIDE
      DIMENSION 1 CMD-CHAIN-TYPES  red_chain
        REPORT-RESPONSIBILITY CMDR
    END MSG-RPT-GUIDE
    SNR-RPT-GUIDE
      DIMENSION 1 CMD-CHAIN-TYPES  red_chain
        DIMENSION 2 SNR-TYPE  sam_radar_rx
	  REPORT-RESPONSIBILITY  CMDR
    END SNR-RPT-GUIDE
    ZONE-CHARACTERISTICS
      DIMENSION 1 ZONE-TYPE  sam_zone
        ZONE-PERMISSION     SNR-RPT-OK
    END ZONE-CHARACTERISTICS

    RESOURCE-ALLOCATION
      LETHAL-ENGAGE-QUEUE-ADD
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE sam_launcher
	      IFF-STATUS IS-NOT FRIEND AND
	      3D-TGT-LOC WITHIN sam_zone
	         RE: YOUR-LOC REFERENCE-LOC
	      AND WPN-STATUS IS-NOT WPN-NON/OP
	      AND BELIEVED-ALIVE
	  USE FILTER 1 SELECTIONS FOR FILTER 2
	    WPN-TYPE sam_launcher
	      BEEN-ASSIGNED IS YES OR ENG-CONTROL-MODE IS sam_btry
	  FROM FILTER 2 SELECTIONS
	    CHOOSE-FROM sam_launcher PICK-AT-MOST 1 NOW 1 TOTAL
      END LETHAL-ENGAGE-QUEUE-ADD
      LETHAL-ENGAGE-QUEUE-DROP
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE sam_launcher
	      IFF-STATUS IS FRIEND
	      OR ENG-CONTROL-MODE IS sam_btry
	         AND 3D-TGT-LOC OUTSIDE sam_zone
		      RE: YOUR-LOC REFERENCE-LOC
	      OR BEEN-ASSIGNED IS NO AND ENG-CONTROL-MODE IS-NOT sam_btry
	      OR WPN-STATUS IS WPN-NON/OP
	      OR BELIEVED-DEAD
	      OR AVAILABLE-RESOURCE NO-MORE-THAN 0 (ROUNDS)
	           RE: tnt ORDNANCE
          FROM FILTER 1 SELECTIONS
	     CHOOSE-FROM sam_launcher PICK-AT-MOST 1 NOW
      END LETHAL-ENGAGE-QUEUE-DROP
      LETHAL-ENGAGE-START
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE sam_launcher
	      TOTAL-ENG'S NO-MORE-THAN 1 (TGTS)
	      AND WPN-STATUS IS-NOT WPN-NON/OP
	  USE FILTER 1 SELECTIONS FOR FILTER 2
	    WPN-TYPE sam_launcher
	      REL-TGT-ALT > 50. (M)  AND REL-TGT-ALT < 15. (KM)
	      AND 2D-DIST < 45. (KM)
	  FROM FILTER 2 SELECTIONS
	    CHOOSE-FROM sam_launcher
	      WITH-TRACKER sam_radar_rx
	      PICK-AT-MOST 1 NOW
      END LETHAL-ENGAGE-START
      LETHAL-ENGAGE-STOP
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE sam_launcher
	      TRACKING-STATUS IS-NOT TRACKING
	      AND TRACKING-STATUS IS-NOT COASTING
	      AND TRACKING-STATUS IS-NOT FIRING
	  USE FILTER 1 SELECTIONS FOR FILTER 2
	    WPN-TYPE sam_launcher
	      REL-TGT-ALT < 40. (M) OR REL-TGT-ALT > 16. (KM)
	      OR 2D-DIST  > 100. (KM)
	      OR AVAILABLE-RESOURCE NO-MORE-THAN 0 (ROUNDS)
	           RE: tnt ORDNANCE
	      OR IFF-STATUS IS FRIEND
	      OR ENG-CONTROL-MODE IS sam_btry
	         AND 3D-TGT-LOC OUTSIDE sam_zone
		        RE: YOUR-LOC REFERENCE-LOC
	      OR BEEN-ASSIGNED IS NO AND ENG-CONTROL-MODE IS-NOT sam_btry
	      OR WPN-STATUS IS WPN-NON/OP
	      OR BELIEVED-DEAD
	  FROM FILTER 2 SELECTIONS
	    CHOOSE-FROM sam_launcher  PICK-AT-MOST 1 NOW
      END LETHAL-ENGAGE-STOP
      LETHAL-ENGAGE-FIRING-START
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE sam_launcher
	      REL-TGT-ALT > 50. (M)  AND REL-TGT-ALT < 15. (KM)
	      AND 2D-DIST < 100. (KM)
	      AND FIRING-NOW IS NO AND TRACKING-STATUS IS TRACKING
	  USE FILTER 1 SELECTIONS FOR FILTER 2
	    WPN-TYPE sam_launcher
	      AVAILABLE-RESOURCE AT-LEAST 1 (ROUNDS)
	        RE: tnt ORDNANCE
          FROM FILTER 2 SELECTIONS
	    CHOOSE-FROM sam_launcher
	        WITH-ORDNANCE   tnt
		WITH-ELEMENT    ANYONE
              PICK-AT-MOST 1 NOW 1 TOTAL
      END LETHAL-ENGAGE-FIRING-START
      LETHAL-ENGAGE-FIRING-STOP
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    WPN-TYPE @{weapon_type}@
	      TRACKING-STATUS IS-NOT TRACKING
	      AND TRACKING-STATUS IS-NOT COASTING
	      AND TRACKING-STATUS IS-NOT FIRING
	  USE FILTER 1 SELECTIONS FOR FILTER 2
	    WPN-TYPE sam_launcher
	      2D-DIST > 50. (KM)
	      OR BELIEVED-DEAD
	  FROM FILTER 2 SELECTIONS
	    CHOOSE-FROM sam_launcher PICK-AT-MOST 1 NOW
      END LETHAL-ENGAGE-FIRING-STOP

      EMCON/TURN-ON
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    SNR-TYPE sam_radar-rx
	      SENSOR-STATUS IS SNR-OFF
	      AND BEEN-ASSIGNED IS YES
	  FROM FILTER 1 SELECTIONS
	    CHOOSE-FROM sam_radar_rx  PICK-AT-MOST 1 NOW 1 TOTAL
      END EMCON/TURN-ON
      EMCON/TURN-OFF
        TGT-TYPE ANYONE
	  USE INPUT FOR FILTER 1
	    SNR-TYPE sam_radar_rx
	      SENSOR-STATUS IS SNR-ON
	      AND BEEN-ASSIGNED IS NO
	      AND TRACKING-STATUS IS-NOT FIRING
	      AND TRACKING-STATUS IS-NOT COASTING
	      AND TRACKING-STATUS IS-NOT TRACKING
	  FROM FILTER 1 SELECTIONS
	    CHOOSE-FROM sam_radar_rx  PICK-AT-MOST 1 NOW 1 TOTAL
      END EMCON/TURN-OFF
    END RESOURCE-ALLOCATION
  END TACTIC

  CAPABILITY  sam_launcher_data
    NUM-SIMULTANEOUS-ROUND    1  (NO-UNITS)
    PLATFORM-VEL-ATTEN        0. (NO-UNITS)

    WPN-SPD-CAPABILITY
      DIMENSION 1 TIME (SEC)  0.  60.
        AVG-SPD (M/SEC)        200.
    END WPN-SPD-CAPABILITY

    WPN-TIME-DELAYS
      SHOOT-TIME-DELAY  1.5 (SEC)  SALVO-FIRING-DELAY 1.5 (SEC)
    END WPN-TIME-DELAYS

    WPN-CHARACTERISTICS
      3D-FLYOUT  LAUNCH-ENVELOPE-P(K)  IMPLICIT-FLYOUT
      CONTROLLED  NO-SELF-DESTRUCT
      NON-PULSED-LASER
    END WPN-CHARACTERISTICS

    WPN-PK
      DIMENSION 1 ELEMENT-TYPES DEFAULT
      DIMENSION 2 LASER-EFF-ENERGY-DENSITY (JOULES/M2)
                   0.0    15000000.0   50000000.0
		      PK (NO-UNITS)
		         0.0    0.99
    END WPN-PK

    LASER-PARAMETERS
      DAMAGE-MODE AVERAGE
      LASER-POWER 25.0 (KW)
      LASER-EXIT-PUPIL-DIAMETER 1.0 (M)
      LASER-WAVELENGTH 0.00000106 (M)
      LASER-MAX-RNG @{Laser Max Range}@ (M)
      LASER-MAX-LASING-TIME 10.0 (SEC)
      LASER-DUTY-CYCLE 100.0 (PERCENT)
    END LASER-PARAMETERS

